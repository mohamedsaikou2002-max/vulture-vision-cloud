# Browser-visible configuration. Set these in Netlify and rebuild after changing them.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Optional consistency check; omit if using a custom Supabase hostname.
VITE_SUPABASE_PROJECT_ID=your-project-ref
# Optional HTTPS voice gateway. Leave unset for browser speech recognition.
# VITE_VOICE_HOST=https://voice.your-domain.example
# Optional HTTPS video URL. By default, the original video ships at /video.mp4.
# VITE_BACKGROUND_VIDEO_URL=/video.mp4
# Never add server secrets, AI keys, worker tokens, or service-role keys to VITE_ variables.
